# Copia este archivo como .env y ajusta los valores. El .env NUNCA se sube al repo.

# 1 en tu máquina, 0 en el servidor
DJANGO_DEBUG=1

# En el servidor es obligatoria. Genera una con:
# python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=

# Separados por coma
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
